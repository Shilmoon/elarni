            "value" : "Ваше значение"
          }
        }
      }
    },
    "Your provider asks you to keep its settings. You can still change them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер просит не менять его настройки. Изменить их всё равно можно."
