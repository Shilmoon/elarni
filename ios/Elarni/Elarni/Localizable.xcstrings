    "Weekly" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еженедельно"
          }
        }
      }
    },
    "When needed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При необходимости"
          }
        }
      }
    },
    "When off, traffic that does not match a rule goes directly to its destination." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, трафик, не подпавший ни под одно правило, идёт напрямую."
          }
        }
      }
    },
    "While connected, proxy tests check the selected VPN path. Disconnect to test other servers, direct TCP, or ICMP. Results expire after five minutes or a configuration change." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При подключении проверки через прокси проверяют путь выбранного VPN. Отключитесь, чтобы проверить другие серверы, прямой TCP или ICMP. Результаты устаревают через пять минут или после изменения конфигурации."
          }
        }
      }
    },
    "Whitelist mode: Russian-entry servers first" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим белого списка: сначала серверы со входом в России"
          }
        }
      }
    },
    "With real DNS, domain rules depend on supported traffic sniffing. Encrypted hostnames and other protocols may need IP rules." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С обычным DNS правила по доменам зависят от поддерживаемого распознавания трафика. Для зашифрованных имён и других протоколов могут понадобиться правила по IP."
          }
        }
      }
    },
    "Xray core" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ядро Xray"
          }
        }
