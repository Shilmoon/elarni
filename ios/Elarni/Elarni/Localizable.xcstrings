          }
        }
      }
    },
    "VPN configuration removed. Connect to create it again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурация VPN удалена. Подключитесь, чтобы создать её заново."
          }
        }
      }
    },
    "VPN connections require a signed app on your iPhone. Import, routing, and settings are available in Simulator." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для VPN-подключений нужно подписанное приложение на iPhone. В симуляторе доступны импорт, маршрутизация и настройки."
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия"
          }
        }
      }
    },
    "Wait for the current operation to finish, or stop the connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
