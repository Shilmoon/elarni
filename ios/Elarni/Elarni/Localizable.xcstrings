        }
      }
    },
    "https://" : {
      "shouldTranslate" : false
    },
    "iOS has no supported system routing-table API. These are Elarni’s configured networks." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В iOS нет поддерживаемого API системной таблицы маршрутов. Здесь показаны сети, настроенные в Elarni."
          }
        }
      }
    },
    "iOS keeps all traffic inside the tunnel, including while it reconnects." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS держит весь трафик внутри туннеля, в том числе во время переподключения."
          }
        }
      }
    },
    "iOS status" : {
