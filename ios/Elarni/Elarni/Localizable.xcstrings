        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние в iOS"
          }
        }
      }
    },
    "iOS stopped the VPN because %@. Open Elarni to reconnect." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS остановила VPN: %@. Откройте Elarni, чтобы переподключиться."
          }
        }
      }
    },
    "iPhone supports domain and IP rules. Desktop executable rules cannot identify other apps on iOS. Use network rules for the traffic you want to route." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone поддерживает правила по доменам и IP. Правила для исполняемых файлов настольной системы не распознают другие приложения в iOS. Для нужного трафика используйте сетевые правила."
          }
        }
      }
    },
