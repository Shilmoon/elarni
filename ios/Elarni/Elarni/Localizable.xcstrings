{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    " Profiles with several outbounds are shared from their own page." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Профилями с несколькими исходящими подключениями делятся с их собственной страницы."
          }
        }
      }
    },
    " The last working servers were kept." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Последние рабочие серверы сохранены."
          }
        }
      }
    },
    " Turn on On Demand in Settings › General so iOS reconnects it automatically." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Включите «По требованию» в разделе «Настройки › Общие», чтобы iOS переподключала его автоматически."
          }
        }
      }
    },
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ %@" : {
      "shouldTranslate" : false
    },
    "%@ details" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: подробности"
          }
        }
      }
    },
    "%@ is gone from %@. Connected to %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ удалён из %2$@. Подключено к %3$@."
          }
        }
      }
    },
    "%@ is limiting requests. Elarni retries later; wait before refreshing again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер «%@» ограничивает запросы. Elarni повторит позже; подождите, прежде чем обновлять снова."
          }
        }
      }
    },
    "%@ left" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось %@"
          }
        }
      }
    },
    "%@ refused the request. The subscription may have expired, run out of traffic or reached its device limit. Contact the provider." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер «%@» отклонил запрос. Возможно, подписка истекла, закончился трафик или достигнут лимит устройств. Свяжитесь с провайдером."
          }
        }
      }
    },
    "%@ removed or changed this link. Ask the provider for a new one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер «%@» удалил или изменил эту ссылку. Попросите у провайдера новую."
          }
        }
      }
    },
    "%@ stays hidden after refreshes. Show it again from Hidden servers." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» останется скрытым после обновлений. Вернуть его можно в «Скрытых серверах»."
          }
        }
      }
    },
    "%@ will see this device as new. If it limits devices, the new ID needs a free slot, and the old one may hold a slot until %@ removes it. Your other subscriptions keep their IDs." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «%1$@» это устройство станет новым. Если провайдер ограничивает число устройств, новому ID нужно свободное место, а старый может занимать место, пока провайдер «%1$@» его не удалит. Остальные подписки сохранят свои ID."
          }
        }
      }
    },
    "%@ · %@" : {
      "shouldTranslate" : false
    },
    "%@ · Local group" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Локальная группа"
          }
        }
      }
    },
    "%@'s name says %@, but its exit is in %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В названии «%1$@» указано: %2$@, но выход — %3$@."
          }
        }
      }
    },
    "%@, prefix length %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, длина префикса %2$@"
          }
        }
      }
    },
    "%@’s server did not answer. Your network may block it, or it is down. Retry later or ask the provider for a mirror." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер провайдера «%@» не ответил. Возможно, ваша сеть его блокирует или он не работает. Повторите позже или попросите у провайдера зеркало."
          }
        }
      }
    },
    "%@’s server reported an error. Nothing is wrong with Elarni or this device; retry later." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер провайдера «%@» сообщил об ошибке. С Elarni и этим устройством всё в порядке; повторите позже."
          }
        }
      }
    },
