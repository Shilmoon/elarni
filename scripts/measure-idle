#!/usr/bin/env python3
"""Measure what a connected, idle Elarni costs: the CPU time and memory of its processes.

Connect, leave the computer alone with no traffic through Elarni, and run it. It samples every process
whose name contains "elarni" (the app, the core, the service or packet tunnel) once a second for
--seconds, then prints each one's share of one CPU core and its average and peak resident memory. A
battery drains with that CPU share, so the share stands in for battery use. --cpu-limit (percent of one
core, all processes together) and --memory-limit (MiB, all together at the peak) turn it into a check.
"""
import argparse
import ctypes
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))
from check_report import record_check
record_check(ROOT)

parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
parser.add_argument('--seconds', type=int, default=60, help='How long to sample.')
parser.add_argument('--cpu-limit', type=float, help='Fail when all processes together use more percent of one core.')
parser.add_argument('--memory-limit', type=float, help='Fail when all processes together hold more MiB at the peak.')
args = parser.parse_args()


def linux():
    """{pid: (name, cpu seconds, resident bytes)} from /proc."""
    tick, page = os.sysconf('SC_CLK_TCK'), os.sysconf('SC_PAGE_SIZE')
    result = {}
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / 'stat').read_text()
            resident = int((entry / 'statm').read_text().split()[1]) * page
        except OSError:
            continue  # The process ended while it was read.
        name = stat[stat.index('(') + 1:stat.rindex(')')]
        fields = stat[stat.rindex(')') + 2:].split()
        result[int(entry.name)] = (name, (int(fields[11]) + int(fields[12])) / tick, resident)
    return result


def macos():
    result = {}
    output = subprocess.run(['ps', '-A', '-o', 'pid=,time=,rss=,comm='], capture_output=True, text=True, check=True).stdout
    for line in output.splitlines():
        pid, used, rss, command = line.split(None, 3)
        # ps prints CPU time as [[dd-]hh:]mm:ss.ss.
        days, _, clock = used.rpartition('-')
        seconds = 0.0
        for part in clock.split(':'):
            seconds = seconds * 60 + float(part)
        result[int(pid)] = (os.path.basename(command), seconds + int(days or 0) * 86400, int(rss) * 1024)
    return result


def windows():
    from ctypes import wintypes

    class Entry(ctypes.Structure):
        _fields_ = [('dwSize', wintypes.DWORD), ('cntUsage', wintypes.DWORD), ('th32ProcessID', wintypes.DWORD),
                    ('th32DefaultHeapID', ctypes.c_size_t), ('th32ModuleID', wintypes.DWORD), ('cntThreads', wintypes.DWORD),
                    ('th32ParentProcessID', wintypes.DWORD), ('pcPriClassBase', ctypes.c_long), ('dwFlags', wintypes.DWORD),
                    ('szExeFile', ctypes.c_wchar * 260)]

    class Counters(ctypes.Structure):
        _fields_ = [('cb', wintypes.DWORD), ('PageFaultCount', wintypes.DWORD)] + [
            (name, ctypes.c_size_t) for name in ('PeakWorkingSetSize', 'WorkingSetSize', 'QuotaPeakPagedPoolUsage',
                                                 'QuotaPagedPoolUsage', 'QuotaPeakNonPagedPoolUsage', 'QuotaNonPagedPoolUsage',
                                                 'PagefileUsage', 'PeakPagefileUsage')]

    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
    kernel.OpenProcess.restype = wintypes.HANDLE
    snapshot = kernel.CreateToolhelp32Snapshot(2, 0)  # TH32CS_SNAPPROCESS
    result = {}
    try:
        entry = Entry(dwSize=ctypes.sizeof(Entry))
        more = kernel.Process32FirstW(snapshot, ctypes.byref(entry))
        while more:
            name, pid = entry.szExeFile, entry.th32ProcessID
            if 'elarni' in name.lower():
                handle = kernel.OpenProcess(0x1000 | 0x0010, False, pid)  # QUERY_LIMITED_INFORMATION | VM_READ
                if handle:
                    try:
                        times = [wintypes.FILETIME() for _ in range(4)]
                        counters = Counters(cb=ctypes.sizeof(Counters))
                        if kernel.GetProcessTimes(handle, *map(ctypes.byref, times)) and \
                                kernel.K32GetProcessMemoryInfo(handle, ctypes.byref(counters), counters.cb):
                            used = sum((time.dwHighDateTime << 32 | time.dwLowDateTime) for time in times[2:]) / 1e7
                            result[pid] = (name, used, counters.WorkingSetSize)
                    finally:
                        kernel.CloseHandle(handle)
                else:
                    result[pid] = (name, None, None)  # A service another account runs needs an elevated terminal.
            more = kernel.Process32NextW(snapshot, ctypes.byref(entry))
    finally:
        kernel.CloseHandle(snapshot)
    return result


sample = {'linux': linux, 'darwin': macos, 'win32': windows}[sys.platform]


def elarni():
    return {pid: value for pid, value in sample().items() if 'elarni' in value[0].lower() and pid != os.getpid()}


first, start = elarni(), time.monotonic()
if not first:
    raise SystemExit('No Elarni process is running; start Elarni and connect first.')
peaks, totals, counts, last = {}, {}, {}, first
while time.monotonic() - start < args.seconds:
    time.sleep(1)
    last = elarni()
    for pid, (_, _, resident) in last.items():
        if resident is not None:
            peaks[pid] = max(peaks.get(pid, 0), resident)
            totals[pid] = totals.get(pid, 0) + resident
            counts[pid] = counts.get(pid, 0) + 1
elapsed = time.monotonic() - start
cpu_total = peak_total = 0.0
unreadable = []
for pid, (name, used, _) in sorted(first.items(), key=lambda item: item[1][0].lower()):
    if pid not in last:
        print(f'{name} ({pid}) exited during the measurement')
        continue
    if used is None or last[pid][1] is None:
        unreadable.append(f'{name} ({pid})')
        continue
    share = (last[pid][1] - used) / elapsed * 100
    cpu_total += share
    peak_total += peaks[pid] / 2**20
    print(f'{name} ({pid}): {share:.2f}% of one core, memory {totals[pid] / counts[pid] / 2**20:.1f} MiB on average, '
          f'{peaks[pid] / 2**20:.1f} MiB at the peak')
print(f'All together over {elapsed:.0f} s: {cpu_total:.2f}% of one core, {peak_total:.1f} MiB at the peaks')
if unreadable:
    print('Not readable without an elevated terminal: ' + ', '.join(unreadable))
failures = []
if args.cpu_limit is not None and cpu_total > args.cpu_limit:
    failures.append(f'CPU {cpu_total:.2f}% is over {args.cpu_limit}%')
if args.memory_limit is not None and peak_total > args.memory_limit:
    failures.append(f'memory {peak_total:.1f} MiB is over {args.memory_limit} MiB')
if failures:
    raise SystemExit('; '.join(failures))
