#!/usr/bin/env python3
"""Snapshot explicitly selected public project source, excluding local/private state.

This project-source archive is not a claim of complete dependency source compliance.
Publish matching dependency sources and review their notices before distribution.
"""
import argparse
import json
from pathlib import Path
import tarfile

from release_support import ROOT, prepare_output, source_paths, version, write_manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--list', action='store_true', help='Review the public file list without reading contents')
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    files = source_paths()
    if args.list:
        print('\n'.join(path.as_posix() for path in files))
        return
    if not args.output:
        parser.error('Choose --list or --output')
    prepare_output(args.output)
    name = 'Elarni-' + version().replace('+', '-') + '-project-source'
    archive = args.output / (name + '.tar.gz')
    with tarfile.open(archive, 'x:gz') as package:
        for path in files:
            package.add(ROOT / path, arcname=Path(name) / path, recursive=False)
    print(json.dumps(write_manifest(args.output, [archive], 'source', 'project-source'), indent=2))


if __name__ == '__main__':
    main()
