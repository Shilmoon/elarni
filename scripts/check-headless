#!/usr/bin/env python3
"""Linux headless acceptance: private keyring/catalog and isolated synthetic peers."""
import argparse
import concurrent.futures
import http.server
import json
import os
from pathlib import Path
import pwd
import runpy
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time

ROOT = Path(__file__).resolve().parent.parent
vpn = runpy.run_path(str(ROOT / 'scripts/check-linux-vpn'))
Core = vpn['Core']


def port():
    with socket.socket() as listener:
        listener.bind(('127.0.0.1', 0))
        return listener.getsockname()[1]


def check(bundle):
    passed = []
    children = []
    subscription = {'body': b'', 'requests': 0}
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == '/subscription':
                subscription['requests'] += 1
                self.send_response(200)
                self.end_headers()
                self.wfile.write(subscription['body'])
                return
            self.send_response(204)
            self.end_headers()
        def log_message(self, *args):
            pass
    target = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    threading.Thread(target=target.serve_forever, daemon=True).start()
    with tempfile.TemporaryDirectory(prefix='elarni-headless-') as temporary:
        root = Path(temporary)
        env = os.environ.copy()
        for key in ('HOME', 'XDG_DATA_HOME', 'XDG_CONFIG_HOME', 'XDG_CACHE_HOME', 'XDG_RUNTIME_DIR'):
            path = root / key; path.mkdir(mode=0o700); env[key] = str(path)
        env.pop('DISPLAY', None); env.pop('WAYLAND_DISPLAY', None)
        private = root / 'control'; private.mkdir(mode=0o700)
        control = private / 'control.sock'
        password = root / 'keyring-password'; password.write_text('synthetic-fixture-keyring'); password.chmod(0o600)
        cli = [str(bundle / 'elarni-cli'), '--socket', str(control)]
        daemon_args = ['dbus-run-session', '--', *cli, 'daemon', '--keyring-password-file', str(password)]
        log = (root / 'daemon.log').open('w')
        def start():
            daemon = subprocess.Popen(daemon_args, env=env, stdout=log, stderr=log, start_new_session=True)
            children.append(daemon)
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                if daemon.poll() is not None:
                    raise AssertionError('daemon exited: ' + (root / 'daemon.log').read_text())
                if control.exists():
                    try:
                        command('status')
                        return daemon
                    except Exception:
                        pass
                time.sleep(.1)
            raise AssertionError('daemon startup timed out: ' + (root / 'daemon.log').read_text())
        def command(*args, data=None, success=True):
            result = subprocess.run([*cli, *args], input=data, text=True, capture_output=True, timeout=180, env=env)
            reply = json.loads(result.stdout or result.stderr)
            assert bool(reply.get('success')) == success, (args, reply)
            assert result.returncode == (0 if success else 1), (args, result.returncode)
            return reply.get('data', reply)
        def stop(daemon):
            os.killpg(daemon.pid, signal.SIGTERM)
            try:
                daemon.wait(timeout=30)
            except subprocess.TimeoutExpired:
                group = subprocess.run(['ps', '-eo', 'pid,pgid,stat,args'], capture_output=True, text=True).stdout.splitlines()
                left = [line for line in group if line.split()[1] == str(daemon.pid)]
                raise AssertionError(f'daemon outlived SIGTERM: {left}\n' + (root / 'daemon.log').read_text()[-6000:])
            deadline = time.monotonic() + 30
            while control.exists() and time.monotonic() < deadline:
                time.sleep(.1)
            assert not control.exists(), 'daemon did not clean up its socket'
        upstreams = []
        try:
            for _ in range(2):
                number = port()
                core = Core(bundle / 'elarni-core', env=env)
                core.request('runXrayFromJson', {'configJSON': json.dumps({
                    'inbounds': [{'protocol': 'socks', 'listen': '127.0.0.1', 'port': number, 'settings': {'udp': True}}],
                    'outbounds': [{'protocol': 'freedom'}]})})
                upstreams.append((number, core))
            daemon = start()
            assert command('status')['state'] in ('prepared', 'disconnected')
            assert control.stat().st_mode & 0o777 == 0o600
            passed.append('no-display-private-control')
            for name, (number, _) in zip(('Primary fixture', 'Backup fixture'), upstreams):
                command('import', '-', data=f'socks5://127.0.0.1:{number}#{name.replace(" ", "%20")}')
            sources = command('profiles')['subscriptions']
            # Pasted links share one local source.
            assert len(sources) == 1 and [n['name'] for n in sources[0]['nodes']] == ['Primary fixture', 'Backup fixture'], sources
            assert 'config' not in json.dumps(sources)
            passed.append('local-import-and-redaction')
            subscription['body'] = f'socks5://127.0.0.1:{upstreams[0][0]}#Subscription'.encode()
            warning = command('import', '-', data=f'http://127.0.0.1:{target.server_port}/subscription')
            assert warning.get('challenge') and warning.get('subscriptionId'), warning
            assert set(warning['riskCodes']) == {'cleartext_http', 'loopback_target'}, warning
            assert subscription['requests'] == 0, 'Source fetched before approval'
            command('refresh', warning['subscriptionId'], 'invalid-challenge', success=False)
            assert subscription['requests'] == 0, 'Invalid challenge authorized a fetch'
            command('refresh', warning['subscriptionId'], warning['challenge'])
            assert subscription['requests'] == 1
            passed.append('source-approval-challenge-and-explicit-refresh')
            subscription['body'] = f'socks5://127.0.0.1:{upstreams[1][0]}#Subscription'.encode()
            def fetched():
                return next(s['nodes'] for s in command('profiles')['subscriptions'] if s['id'] == warning['subscriptionId'])
            before = fetched()
            refreshed = command('refresh', warning['subscriptionId'])
            assert subscription['requests'] == 2
            # Catalog changes apply at once: no review is pending anywhere.
            assert 'review' not in refreshed and 'review' not in command('status')
            after = fetched()
            # A unique server name keeps its ID across a provider change, so a selection follows it.
            # The failover below reaches the second upstream only through this refreshed server.
            assert len(after) == 1 and after[0]['id'] == before[0]['id'] and after[0]['name'] == 'Subscription', (before, after)
            passed.append('refresh-applies-catalog-changes')
            methods = command('commands')['methods']
            assert {'updateRoutingProfile', 'updateInboundCredentials', 'exportCatalogBackup',
                    'restoreCatalogBackup', 'exportEvidence', 'systemInfo', 'routeTable'} <= set(methods)
            assert 'setLaunchAtLogin' not in methods  # systemd owns service startup
            node = sources[0]['nodes'][0]['id']
            command('call', 'setNodeFavorite', '-', data=json.dumps({'nodeId': node, 'favorite': True}))
            assert command('profiles')['subscriptions'][0]['nodes'][0]['favorite']
            assert command('call', 'systemInfo')['processorCount'] > 0
            assert 'table' in command('call', 'routeTable')
            passed.append('complete-call-controls-and-diagnostics')
            sealed = command('call', 'exportCatalogBackup', '-',
                             data=json.dumps({'password': 'synthetic headless backup password'}))
            assert 'Primary fixture' not in sealed['text']
            command('call', 'restoreCatalogBackup', '-', success=False,
                    data=json.dumps({'password': 'wrong', 'content': sealed['text']}))
            assert len(command('profiles')['subscriptions']) == 2
            command('call', 'restoreCatalogBackup', '-',
                    data=json.dumps({'password': 'synthetic headless backup password', 'content': sealed['text']}))
            assert len(command('profiles')['subscriptions']) == 2
            assert command('call', 'exportEvidence')['schemaVersion'] == 2
            passed.append('dialog-free-encrypted-backup-restore-and-evidence')
            probe = command('probe', 'Primary fixture', f'http://127.0.0.1:{target.server_port}/check')
            assert probe['status'] == 'success' and probe['latencyMs'] >= 0, probe
            passed.append('standalone-profile-probe')
            proxy_port = port()
            command('settings', '-', data=json.dumps({'xrayTunEnabled': False, 'socksPort': proxy_port}))
            # A fresh install's listeners require a generated login; a headless user sets their own.
            command('call', 'updateInboundCredentials', '-',
                    data=json.dumps({'username': 'headless', 'password': 'synthetic-proxy-password'}))
            checks = root / 'checks.json'
            checks.write_text(json.dumps([
                {'id': 'loopback', 'url': f'http://127.0.0.1:{target.server_port}/check', 'expectedStatus': 204, 'expectedBody': ''},
                {'id': 'localhost', 'url': f'http://localhost:{target.server_port}/check', 'expectedStatus': 204, 'expectedBody': ''}]))
            # The subscription's server (the second upstream) is the backup in another source.
            recovery = command('failover', 'Primary fixture', 'Subscription', str(checks))
            assert len(recovery['configuration']['nodeIDs']) == 2
            primary, backup = recovery['configuration']['nodeIDs']
            passed.append('cross-source-failover-configuration')
            before = command('profiles')['selectedNodeId']
            invalid = root / 'invalid-checks.json'; invalid.write_text('[]')
            command('failover', 'Subscription', 'Primary fixture', str(invalid), success=False)
            assert command('profiles')['selectedNodeId'] == before
            passed.append('invalid-failover-is-atomic')
            command('connect')
            def curl(login):
                return subprocess.run(['curl', '--silent', '--show-error', '--fail', '--max-time', '10',
                    '--noproxy', '', '--proxy', f'socks5h://{login}127.0.0.1:{proxy_port}', '-o', '/dev/null', '-w', '%{http_code}',
                    f'http://127.0.0.1:{target.server_port}/check'], capture_output=True, text=True, timeout=15)
            def traffic():
                response = curl('headless:synthetic-proxy-password@')
                assert response.returncode == 0 and response.stdout == '204', response.stderr
            # curl's 97: the proxy offered no method it could use without a login.
            refused = curl('')
            assert refused.returncode == 97, (refused.returncode, refused.stderr)
            traffic(); passed.append('local-proxy-login-and-traffic')
            # Only the disposable upstream dies. Neither host routing nor the
            # user's VPN is changed by this test.
            upstreams[0][1].close()
            failure = command('probe', 'Primary fixture',
                              f'http://127.0.0.1:{target.server_port}/check', success=False)
            assert failure['diagnostics']['stage'] == 'target_request', failure
            assert set(failure['diagnostics']) <= {'stage', 'code', 'httpStatus', 'cleanupState'}
            passed.append('failed-probe-has-safe-diagnostics')
            deadline = time.monotonic() + 150
            latest = None
            while time.monotonic() < deadline:
                latest = command('status')
                if latest['selectedNodeId'] == backup and latest['automation']['status'] in ('healthy', 'selected'):
                    break
                time.sleep(1)
            else:
                raise AssertionError('backup was not selected: ' + json.dumps(latest))
            traffic(); passed.append('failed-primary-switches-to-verified-backup')
            stop(daemon)
            daemon = start()
            deadline = time.monotonic() + 20
            while time.monotonic() < deadline:
                state = command('status')
                if state['state'] == 'connected': break
                time.sleep(.2)
            else: raise AssertionError('saved intent did not resume')
            assert state['selectedNodeId'] == backup
            traffic(); passed.append('service-restart-resumes-saved-intent')
            command('disconnect')
            stop(daemon)
            encrypted = Path(env['XDG_DATA_HOME']) / 'Elarni/catalog.enc'
            assert encrypted.read_bytes().startswith(b'RVL1')
            assert b'Primary fixture' not in encrypted.read_bytes()
            assert encrypted.stat().st_mode & 0o777 == 0o600
            daemon = start()
            time.sleep(3)
            state = command('status')
            assert state['state'] in ('prepared', 'disconnected')
            assert state['automation']['status'] == 'intentRequired'
            passed.append('encrypted-relaunch-and-manual-stop')
            duplicate = subprocess.Popen(daemon_args, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            duplicate.communicate(timeout=15)
            assert duplicate.returncode != 0
            assert command('status')['state'] in ('prepared', 'disconnected')
            passed.append('duplicate-daemon-preserves-owner')

            peer = subprocess.Popen(['ip', 'netns', 'exec', 'elarni-peer', sys.executable,
                str(ROOT / 'scripts/check-linux-vpn'), '--peer', '--core', str(bundle / 'elarni-core')],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log, text=True, start_new_session=True)
            children.append(peer)
            assert json.loads(peer.stdout.readline()).get('ready'), 'VPN peer did not start'
            command('call', 'configureAutomation', '-', data=json.dumps({
                'schemaVersion': 1, 'enabled': False, 'policy': 'fixed',
                'subscriptionID': '', 'nodeIDs': [], 'targets': []}))
            known = {n['id'] for s in command('profiles')['subscriptions'] for n in s['nodes']}
            command('import', '-', data=json.dumps({
                'outbounds': [{'protocol': 'vless', 'settings': {'vnext': [
                    {'address': vpn['PEER4'], 'port': 18080,
                     'users': [{'id': vpn['USER_ID'], 'encryption': 'none'}]}]}}],
                'dns': {'servers': [{'address': vpn['PEER4'], 'port': 15353}]}}))
            # The pasted JSON joins the local source; select the server it added.
            selected, = {n['id'] for s in command('profiles')['subscriptions'] for n in s['nodes']} - known
            command('select', selected)
            command('settings', '-', data=json.dumps({'xrayTunEnabled': True, 'onDemandEnabled': True,
                'includedRoutes': [vpn['TARGET4'] + '/32', vpn['TARGET6'] + '/128'], 'enforceRoutes': True}))
            def vpn_traffic():
                for address in (vpn['TARGET4'], vpn['TARGET6']):
                    vpn['check_http'](address)
                    vpn['check_udp'](address)
                for address in ('127.0.0.1', '::1', vpn['PEER4']):
                    for kind in (1, 28): vpn['check_dns'](address, kind)
            def owned_pid(executable, argument):
                matches = []
                for proc in Path('/proc').iterdir():
                    if not proc.name.isdigit(): continue
                    try: args = (proc / 'cmdline').read_bytes().split(b'\0')
                    except FileNotFoundError: continue
                    if args[0] == str(executable).encode() and argument.encode() in args:
                        matches.append(int(proc.name))
                assert len(matches) <= 1, (argument, matches)
                return matches[0] if matches else None
            def worker_pid():
                # The supervisor starts its worker through its pinned /proc/<pid>/fd/<n> executable.
                supervisor = owned_pid(bundle / 'elarni-core', '--linux-supervisor')
                try:
                    children = {pid for task in Path(f'/proc/{supervisor}/task').iterdir()
                                for pid in (task / 'children').read_text().split()}
                    workers = [int(pid) for pid in children if b'--linux-worker' in Path(f'/proc/{pid}/cmdline').read_bytes()]
                except FileNotFoundError:  # no supervisor, or one that is exiting
                    return None
                assert len(workers) <= 1, workers
                return workers[0] if workers else None
            def wait_connected(previous_worker=None):
                deadline = time.monotonic() + 30
                while time.monotonic() < deadline:
                    worker = worker_pid()
                    if worker is not None and worker != previous_worker and command('status')['state'] == 'connected':
                        return worker
                    time.sleep(.2)
                raise AssertionError('VPN did not recover: ' + json.dumps(command('status')))
            command('connect'); vpn_traffic()
            passed.append('headless-system-vpn-dual-stack-and-dns')
            other = pwd.getpwnam('nobody')
            denied = subprocess.run([sys.executable, '-c',
                'import socket,sys\ns=socket.socket(socket.AF_UNIX);s.settimeout(2)\n'
                'try: s.connect(sys.argv[1])\nexcept PermissionError: sys.exit(0)\n'
                'raise AssertionError("Foreign user reached private control")', str(control)],
                user=other.pw_uid, group=other.pw_gid, extra_groups=[], capture_output=True, timeout=5)
            assert denied.returncode == 0, denied.stderr
            probe_socket = Path('/run/elarni-probes') / str(os.getuid()) / 'probe.sock'
            probe_socket.chmod(0o666)
            try:
                denied = subprocess.run([sys.executable, '-c',
                    'import socket,sys\ns=socket.socket(socket.AF_UNIX);s.settimeout(2)\n'
                    's.connect(sys.argv[1]);assert s.recv(1)==b""', str(probe_socket)],
                    user=other.pw_uid, group=other.pw_gid, extra_groups=[], capture_output=True, timeout=5)
                assert denied.returncode == 0, denied.stderr
            finally:
                probe_socket.chmod(0o600)
            passed.append('private-control-and-broker-reject-foreign-uid')
            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
                stops = [pool.submit(command, 'disconnect') for _ in range(2)]
                assert all(stop.result()['state'] == 'disconnected' for stop in stops)
            vpn['wait_clean']()
            command('connect'); vpn_traffic()
            passed.append('concurrent-stop-and-vpn-reconnect')
            worker = worker_pid()
            assert worker is not None
            os.kill(worker, signal.SIGKILL)
            wait_connected(worker); vpn_traffic()
            passed.append('worker-death-recovers-through-headless-controller')
            vpn['run']('ip', 'link', 'set', 'rvclient', 'down')
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                if command('status')['automation']['status'] == 'offline': break
                time.sleep(.2)
            else: raise AssertionError('Physical path loss was not observed')
            command('disconnect'); vpn['wait_clean']()
            vpn['run']('ip', 'link', 'set', 'rvclient', 'up')
            time.sleep(3)
            assert command('status')['state'] == 'disconnected', 'Path recovery undid manual Stop'
            passed.append('manual-stop-wins-over-physical-path-recovery')
            command('connect'); vpn_traffic()
            owner = owned_pid(bundle / 'elarni-cli', 'daemon')
            assert owner is not None
            os.kill(owner, signal.SIGKILL)
            daemon.wait(timeout=30)
            vpn['wait_clean']()
            daemon = start()
            wait_connected(); vpn_traffic()
            passed.append('daemon-crash-cleanup-and-durable-intent-recovery')
            command('shutdown')
            daemon.wait(timeout=30)
            vpn['wait_clean']()
            assert not control.exists()
            with socket.socket() as connection:
                assert connection.connect_ex(('127.0.0.1', proxy_port)) != 0
            passed.append('daemon-and-listener-cleanup')
            print(json.dumps({'passed': passed, 'count': len(passed), 'failed': 0, 'skipped': 0}), flush=True)
        finally:
            for child in reversed(children):
                try: os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError: pass
                try: child.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL); child.wait()
            for _, core in upstreams:
                core.close()
            target.shutdown()
            log.close()


if __name__ == '__main__':
    from check_report import record_check
    record_check(ROOT)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bundle', type=Path, default=ROOT / 'build/linux/x64/release/bundle')
    parser.add_argument('--isolated', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if sys.platform != 'linux': raise SystemExit('Run on Linux; no host VPN or routes are used.')
    if os.geteuid() != 0: raise SystemExit('Run with sudo to create disposable namespaces.')
    if not args.isolated:
        os.environ['ELARNI_HEADLESS_TEST_NETNS'] = str(os.stat('/proc/self/ns/net').st_ino)
        os.execvp('unshare', ['unshare', '--mount', '--net', '--pid', '--fork', '--mount-proc',
                             sys.executable, str(Path(__file__).resolve()), '--isolated', *sys.argv[1:]])
    original = os.environ.get('ELARNI_HEADLESS_TEST_NETNS')
    if not original or str(os.stat('/proc/self/ns/net').st_ino) == original:
        raise SystemExit('Refusing to use host networking for headless acceptance.')
    os.environ['ELARNI_ORIGINAL_NETNS'] = original
    vpn['setup_isolation']()
    check(args.bundle.resolve())
