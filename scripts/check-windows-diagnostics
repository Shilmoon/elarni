#!/usr/bin/env python3
"""Exercise a diagnostic helper's automatic recording and one-file export."""
import argparse
import http.server
import json
import os
from pathlib import Path
import runpy
import shutil
import socket
import subprocess
import tempfile
import threading
import zipfile

from check_report import record_check

ROOT = Path(__file__).resolve().parents[1]
record_check(ROOT)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--core', type=Path, required=True)
args = parser.parse_args()
benchmark = runpy.run_path(str(ROOT / 'scripts/benchmark-protocols'))
secret = 'private_profile_payload_must_never_be_exported'


class Target(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(secret.encode())

    def log_message(self, *_):
        pass


with tempfile.TemporaryDirectory(prefix='elarni diagnostics ') as temporary:
    root = Path(temporary)
    core = root / 'elarni-core.exe'
    shutil.copy2(args.core, core)
    # Isolate storage only: enabling recording must come from the binary itself.
    env = dict(os.environ, ELARNI_DIAGNOSTICS_DIR=str(root / 'logs'))
    target = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Target)
    threading.Thread(target=target.serve_forever, daemon=True).start()
    port = benchmark['free_port']()
    config = {'log': {'loglevel': 'none'}, 'inbounds': [
        {'tag': 'elarni-socks', 'listen': '127.0.0.1', 'port': port,
         'protocol': 'socks', 'settings': {'auth': 'noauth', 'udp': True}}],
        'outbounds': [{'tag': secret, 'protocol': 'freedom'}]}
    try:
        with benchmark['Core'](core, {'apiVersion': 1, 'method': 'runXrayFromJson',
                                      'payload': {'configJSON': json.dumps(config)}}, env) as process:
            process.result()
            with benchmark['socks_connect'](port, '127.0.0.1', target.server_port, 5) as conn:
                conn.sendall(b'GET / HTTP/1.0\r\nHost: localhost\r\n\r\n')
                received = b''
                while chunk := conn.recv(4096):
                    received += chunk
                assert secret.encode() in received, 'proxy did not carry the fixture body'
            # Distinct failure: local destination is unavailable, not a bad profile.
            with socket.socket() as blocked:
                blocked.bind(('127.0.0.1', 0))
                try:
                    with benchmark['socks_connect'](port, '127.0.0.1', blocked.getsockname()[1], 5) as conn:
                        conn.sendall(b'GET / HTTP/1.0\r\n\r\n')
                        assert not conn.recv(1), 'non-listening destination unexpectedly served data'
                except (OSError, benchmark['BenchmarkError']):
                    pass
    finally:
        target.shutdown()
        target.server_close()
    exported = subprocess.run([str(core), '--diagnostics-export'], env=env,
                              capture_output=True, text=True, timeout=15)
    assert exported.returncode == 0, exported.stdout + exported.stderr
    archive, = root.glob('Elarni-diagnostics-*.zip')
    with zipfile.ZipFile(archive) as package:
        assert package.testzip() is None
        assert 'manifest.json' in package.namelist()
        data = b'\n'.join(package.read(name) for name in package.namelist())
        assert secret.encode() not in data, 'profile tag or traffic payload leaked'
        events = [json.loads(line) for name in package.namelist() if name.endswith('.jsonl')
                  for line in package.read(name).splitlines()]
    names = {event['event'] for event in events}
    assert {'collector_started', 'diagnostic_build', 'runtime_config', 'core_start_done',
            'socket_dial', 'outbound_done'} <= names, names
    assert any(event['event'] == 'socket_dial' and event.get('code') != 'ok'
               for event in events), 'socket failure missing from export'
    repeated = subprocess.run([str(core), '--diagnostics-export', str(archive)], env=env,
                              capture_output=True, text=True, timeout=15)
    assert repeated.returncode != 0, 'existing export was overwritten'
    print(json.dumps({'passed': ['automatic_collection', 'real_proxy_traffic', 'failed_socket',
                                 'one_file_export', 'payload_redaction', 'no_overwrite'],
                      'events': len(events)}))
