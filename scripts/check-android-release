#!/usr/bin/env python3
"""Exercise a signed, optimized APK through Android UI and a foreign traffic UID."""
import argparse
import base64
from contextlib import ExitStack
import hashlib
import http.server
import json
import os
from pathlib import Path
import re
import shlex
import socketserver
import subprocess
import sys
import threading
import time
import uuid
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))
from check_report import REPORT_ENV, record_check
from tuic_fixture import android_tuic_peer
record_check(ROOT)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--serial', required=True)
parser.add_argument('--apk', type=Path, required=True, help='Signed release APK built from the current source.')
parser.add_argument('--protocol', choices=['socks', 'tuic-native', 'tuic-quic'], default='socks')
args = parser.parse_args()
os.chdir(ROOT)
sdk = Path(os.environ.get('ANDROID_HOME', Path.home() / 'Library/Android/sdk'))
adb = [str(sdk / 'platform-tools/adb'), '-s', args.serial]
report = Path(os.environ[REPORT_ENV])
apk = args.apk.resolve()

def run(*command):
    result = subprocess.run(list(map(str, command)), stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, timeout=60)
    if result.returncode:
        raise RuntimeError(f'{command[0]} exited {result.returncode}: {result.stdout}')
    return result.stdout

def shell(*command):
    return run(*adb, 'shell', shlex.join(list(map(str, command))))

if not args.serial.startswith('emulator-'):
    raise SystemExit('Physical devices are outside this synthetic release check.')
name = run(*adb, 'emu', 'avd', 'name').splitlines()[0].strip()
if name not in ('Elarni_API_30', 'Elarni_API_36_16K'):
    raise SystemExit('Choose a task-owned disposable AVD.')
if shell('getprop', 'sys.boot_completed').strip() != '1':
    raise SystemExit('The AVD is not ready.')
api = shell('getprop', 'ro.build.version.sdk').strip()
page_size = shell('getconf', 'PAGESIZE').strip()
expected = ('30', '4096') if name == 'Elarni_API_30' else ('36', '16384')
if (api, page_size) != expected:
    raise SystemExit(f'The AVD must run API {expected[0]} with {expected[1]}-byte pages.')
badging = run(sdk / 'build-tools/36.0.0/aapt', 'dump', 'badging', apk)
if not re.search(r"^package: name='com.elarni' ", badging, re.M) or 'application-debuggable' in badging:
    raise SystemExit('Expected the non-debuggable com.elarni release APK.')
print(f'Release target: {name}, API {api}, {page_size}-byte pages; '
      f'APK SHA256 {hashlib.sha256(apk.read_bytes()).hexdigest()}', flush=True)

def tree():
    shell('uiautomator', 'dump', '/sdcard/elarni-release-ui.xml')
    return ET.fromstring(shell('cat', '/sdcard/elarni-release-ui.xml'))

def labelled(root, label):
    return next((node for node in root.iter('node')
                 if node.get('text', '').casefold() == label.casefold()
                 or node.get('content-desc', '').casefold() == label.casefold()), None)

def tap(node):
    bounds = list(map(int, re.findall(r'\d+', node.get('bounds', ''))))
    if len(bounds) != 4 or bounds[2] <= bounds[0] or bounds[3] <= bounds[1]:
        raise RuntimeError('UI target has no visible bounds')
    shell('input', 'tap', (bounds[0] + bounds[2]) // 2, (bounds[1] + bounds[3]) // 2)

def wait_label(label, click=False, consent=False):
    deadline = time.monotonic() + 25
    while time.monotonic() < deadline:
        root = tree()
        node = labelled(root, label)
        if node is not None:
            if click:
                tap(node)
            return root
        if consent:
            for title in ('OK', 'Allow'):
                button = labelled(root, title)
                if button is not None and button.get('package') in (
                        'com.android.vpndialogs', 'com.google.android.permissioncontroller',
                        'com.android.permissioncontroller'):
                    tap(button)
        time.sleep(.15)
    raise RuntimeError(f'Did not reach UI state: {label}')

def open_app(link=None):
    command = ['am', 'start', '-W', '-n', 'com.elarni/com.elarni.MainActivity']
    if link:
        command += ['-a', 'android.intent.action.VIEW', '-d', link]
    shell(*command)

def link_disconnect():
    open_app('elarni://disconnect')
    # Link-driven disconnects ask the user first.
    wait_label('A link asks Elarni to disconnect.')
    wait_label('Disconnect', click=True)
    wait_label('Disconnected')

class Direct(http.server.BaseHTTPRequestHandler):
    prefix = b'direct:'
    def do_GET(self):
        body = self.prefix + b'elarni-release'
        self.send_response(200)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *_):
        pass

class ProxyHTTP(Direct):
    prefix = b'proxy:'

class ProxyUDP(socketserver.BaseRequestHandler):
    def handle(self):
        data, sock = self.request
        sock.sendto(b'proxy:' + data, self.client_address)

class Socks(socketserver.StreamRequestHandler):
    # No outbound sockets: this peer only recognizes a SOCKS handshake and
    # answers the fixture's bounded HTTP request with an independent marker.
    def handle(self):
        self.connection.settimeout(5)
        try:
            self.exchange()
        except (TimeoutError, ConnectionError):
            # Android may open unrelated TLS/idle connections through the VPN.
            # The traffic client's independent result still fails incomplete HTTP.
            print('Synthetic SOCKS peer: incomplete background connection closed.', flush=True)

    def exchange(self):
        if self.rfile.read(1) != b'\x05':
            return
        count = self.rfile.read(1)
        if not count:
            return
        self.rfile.read(count[0])
        self.wfile.write(b'\x05\x00')
        header = self.rfile.read(4)
        if len(header) != 4 or header[:2] != b'\x05\x01':
            return
        length = {1: 4, 4: 16}.get(header[3])
        if header[3] == 3:
            size = self.rfile.read(1)
            if not size:
                return
            length = size[0]
        if length is None:
            return
        self.rfile.read(length + 2)
        self.wfile.write(b'\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x00')
        if self.rfile.read(1) != b'G':
            return
        request = self.rfile.readline(4096)
        if request != b'ET /fixture HTTP/1.1\r\n':
            return
        total = len(request) + 1
        while True:
            line = self.rfile.readline(4096)
            total += len(line)
            if total > 8192:
                return
            if not line:
                return
            if line in (b'\r\n', b'\n'):
                break
        body = b'proxy:elarni-release'
        self.wfile.write(b'HTTP/1.1 200 OK\r\nContent-Length: ' + str(len(body)).encode()
                         + b'\r\nConnection: close\r\n\r\n' + body)

def traffic(port, expected, vpn):
    token = uuid.uuid4().hex
    shell('am', 'start', '-n', 'com.elarni.traffic.a/com.elarni.traffic.TrafficActivity',
          '--es', 'token', token, '--es', 'mode', 'tcp', '--es', 'address',
          '198.18.0.81' if vpn and args.protocol != 'socks' else '10.0.2.2', '--ei', 'port', port)
    deadline = time.monotonic() + 12
    while time.monotonic() < deadline:
        try:
            result = json.loads(shell('run-as', 'com.elarni.traffic.a', 'cat', 'files/result.json'))
        except (RuntimeError, json.JSONDecodeError):
            result = {}
        if result.get('token') == token:
            print('Foreign UID traffic:', json.dumps(result), flush=True)
            if not result.get('success') or result.get('vpn') is not vpn or expected not in result.get('body', ''):
                raise RuntimeError('Release traffic did not match the independent fixture')
            return
        time.sleep(.1)
    raise RuntimeError('Foreign traffic client did not finish')

def capture(name):
    (report / (name + '.xml')).write_bytes(ET.tostring(tree()))
    (report / (name + '.png')).write_bytes(subprocess.check_output(adb + ['exec-out', 'screencap', '-p'], timeout=15))

with ExitStack() as peers:
    direct = peers.enter_context(http.server.ThreadingHTTPServer(('127.0.0.1', 0), Direct))
    proxy = peers.enter_context(socketserver.ThreadingTCPServer(('127.0.0.1', 0), Socks))
    proxy_http = peers.enter_context(http.server.ThreadingHTTPServer(('127.0.0.1', 0), ProxyHTTP))
    proxy_udp = peers.enter_context(socketserver.ThreadingUDPServer(('127.0.0.1', 0), ProxyUDP))
    for server in (direct, proxy, proxy_http, proxy_udp):
        threading.Thread(target=server.serve_forever, daemon=True).start()
    link = f'socks://10.0.2.2:{proxy.server_address[1]}#Release%20fixture'
    if args.protocol != 'socks':
        port, certificate = peers.enter_context(android_tuic_peer(ROOT, proxy_http.server_port, proxy_udp.server_address[1]))
        profile = {'remarks': 'Release fixture', 'outbounds': [{'tag': 'proxy', 'protocol': 'tuic',
            'settings': {'address': '10.0.2.2', 'port': port, 'uuid': '00000000-0000-4000-8000-000000000001',
                         'password': 'synthetic-tuic-only', 'udpRelayMode': args.protocol.removeprefix('tuic-')},
            'streamSettings': {'security': 'tls', 'tlsSettings': {'serverName': 'tuic-fixture.example', 'alpn': ['h3'],
                'disableSystemRoot': True, 'certificates': [{'usage': 'verify',
                    'certificate': base64.b64decode(certificate).decode().splitlines()}]}}}]}
        link = 'incy://import/' + base64.b64encode(json.dumps(profile).encode()).decode()
    print('Release protocol: ' + args.protocol, flush=True)
    try:
        shell('am', 'force-stop', 'com.elarni.debug')
        print(run(*adb, 'install', '-r', apk), flush=True)
        # This named disposable AVD's release package is owned by this fixture.
        shell('pm', 'clear', 'com.elarni')
        print(run(*adb, 'install', '-r', ROOT / 'android/traffic-fixture/build/outputs/apk/a/debug/traffic-fixture-a-debug.apk'), flush=True)
        open_app(link)
        wait_label('Import', click=True)
        wait_label('Release fixture', click=True)
        wait_label('Connect', click=True)
        wait_label('Connected', consent=True)
        traffic(direct.server_port, 'proxy:elarni-release', True)
        capture('release-connected')
        link_disconnect()
        traffic(direct.server_port, 'direct:elarni-release', False)
        shell('am', 'force-stop', 'com.elarni')
        print(run(*adb, 'install', '-r', apk), flush=True)
        open_app()
        wait_label('Release fixture')
        wait_label('Connect', click=True)
        wait_label('Connected', consent=True)
        traffic(direct.server_port, 'proxy:elarni-release', True)
        link_disconnect()
        capture('release-persisted')
        print('Release acceptance passed: UI import, JNI/core VPN traffic, disconnect cleanup, '
              'encrypted catalog after signed reinstall, reconnect traffic; 5 boundaries, no skips.', flush=True)
    except Exception:
        capture('release-failure')
        raise
    finally:
        shell('am', 'force-stop', 'com.elarni')
        direct.shutdown()
        proxy.shutdown()
        proxy_http.shutdown()
        proxy_udp.shutdown()
