#!/usr/bin/env python3
"""Windows TUN acceptance with synthetic HTTP/DNS peers; run elevated on a test host."""
import ctypes
import argparse
import base64
from contextlib import ExitStack
import http.client
import http.server
import ipaddress
import json
import os
from pathlib import Path
import shutil
import socket
import struct
import subprocess
import sys
import threading
import time
import uuid


def owner(core):
    child = subprocess.Popen([core], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    child.stdin.write(sys.stdin.readline())
    child.stdin.flush()
    reply = json.loads(child.stdout.readline())
    reply.setdefault('data', {})['brokerPid'] = child.pid
    print(json.dumps(reply), flush=True)
    sys.stdin.read()
    child.stdin.close()
    child.wait(timeout=15)


if len(sys.argv) == 3 and sys.argv[1] == '--owner':
    owner(sys.argv[2])
    raise SystemExit(0)
from check_report import record_check
from tuic_fixture import android_tuic_peer
record_check(Path(__file__).resolve().parent.parent)
modes = ('graceful', 'reconnect', 'startup-cancel', 'helper-death', 'broker-death', 'block-broker-death', 'app-owner-death', 'route-enforcement', 'session-limits', 'adapter-loss', 'per-app')
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--deny-elevation', action='store_true')
parser.add_argument('--case', choices=modes, action='append')
parser.add_argument('--protocol', choices=['vless', 'tuic-native', 'tuic-quic'], default='vless')
arguments = parser.parse_args()
deny_elevation = arguments.deny_elevation
if sys.platform != 'win32' or (not deny_elevation and not ctypes.windll.shell32.IsUserAnAdmin()):
    raise SystemExit('Run this check from an elevated Windows terminal on the test host.')
root = Path(__file__).resolve().parent.parent
core = Path(os.environ.get('ELARNI_TEST_CORE', root / 'build/windows/x64/runner/Release/elarni-core.exe'))
if not core.is_file():
    raise SystemExit('Build the Windows release first.')
body = b'elarni-windows-vpn-synthetic-response'
user_id = '00000000-0000-4000-8000-000000000001'
fixture_name = uuid.uuid4().hex + '.elarni.test'
processes = []
adapters = []
dns_queries = []
session = ctypes.c_ulong()
assert ctypes.windll.kernel32.ProcessIdToSessionId(os.getpid(), ctypes.byref(session)), 'Could not read the Windows session'
# The elevated helper runs in this session.
session_adapter = 'elarni-tun-' + str(session.value)


def powershell(script):
    value = subprocess.run(['powershell.exe', '-NoProfile', '-Command', script], capture_output=True, text=True, timeout=20)
    if value.returncode:
        raise RuntimeError(f'Windows resource inspection failed (exit {value.returncode}): {value.stderr.strip()}')
    return value.stdout.strip()


def free_port():
    with socket.socket() as listener:
        listener.bind(('127.0.0.1', 0))
        return listener.getsockname()[1]


def request(process, method, payload):
    process.stdin.write(json.dumps({'apiVersion': 1, 'method': method, 'payload': payload}) + '\n')
    process.stdin.flush()
    reply = {}
    failure = []
    def read():
        try:
            while True:
                value = json.loads(process.stdout.readline())
                # A session streams metrics and log events between replies.
                if 'event' not in value:
                    reply.update(value)
                    break
        except Exception as error:
            failure.append(type(error).__name__)
    thread = threading.Thread(target=read, daemon=True)
    thread.start()
    thread.join(120 if deny_elevation else 45)
    if thread.is_alive() or failure or not reply.get('success'):
        raise RuntimeError('Native startup failed: ' + str(reply.get('error', 'no readiness response')))
    return reply.get('data') or {}


def start_process(arguments):
    process = subprocess.Popen(arguments, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    processes.append(process)
    return process


def native(method, payload):
    # One command per one-shot core, as the app sends its DNS guard check and clear.
    process = start_process([str(core)])
    try:
        return request(process, method, payload)
    finally:
        process.stdin.close()
        process.wait(timeout=15)


def http_target(address, port, expect_success=True):
    client = http.client.HTTPConnection(address, port, timeout=4)
    try:
        client.request('GET', '/synthetic-fixture')
        response = client.getresponse()
        good = response.status == 200 and response.read() == body
    except (OSError, http.client.HTTPException):
        good = False
    finally:
        client.close()
    assert good == expect_success, 'Unexpected traffic result for synthetic ' + address


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        try:
            self.wfile.write(body)
        except ConnectionError:
            # The admission test deliberately closes an incomplete HTTP request.
            pass
    def log_message(self, *_):
        pass


def dns_server(server):
    while True:
        try:
            packet, peer = server.recvfrom(65536)
        except OSError:
            return
        if len(packet) < 17:
            continue
        end = 12
        labels = []
        try:
            while packet[end]:
                length = packet[end]
                labels.append(packet[end + 1:end + 1 + length].decode('ascii'))
                end += length + 1
            kind, _ = struct.unpack('!HH', packet[end + 1:end + 5])
            question = packet[12:end + 5]
            name = '.'.join(labels).lower()
        except (IndexError, UnicodeError, struct.error):
            continue
        answer = b''
        if name == fixture_name and kind in (1, 28):
            dns_queries.append(kind)
            address = ipaddress.ip_address('198.18.0.1' if kind == 1 else '2001:db8::1').packed
            answer = b'\xc0\x0c' + struct.pack('!HHIH', kind, 1, 1, len(address)) + address
        response = packet[:2] + struct.pack('!HHHHH', 0x8180 if answer else 0x8183, 1, int(bool(answer)), 0, 0) + question + answer
        server.sendto(response, peer)


def dns_probe(allowed):
    labels = b''.join(bytes([len(label)]) + label.encode('ascii') for label in fixture_name.split('.')) + b'\0'
    packet = struct.pack('!HHHHHH', 4321, 0x0100, 1, 0, 0, 0) + labels + struct.pack('!HH', 1, 1)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as client:
        client.settimeout(1)
        try:
            client.sendto(packet, ('127.0.0.1', 53))
            reply, _ = client.recvfrom(65536)
            received = reply[:2] == packet[:2]
        except OSError:
            received = False
    assert received == allowed, 'DNS guard or cleanup did not match the required state'


def wait_clean(adapter, dns=True):
    for _ in range(30):
        present = powershell("@(Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object Name -eq '" + adapter + "').Count")
        if present == '0':
            dns_probe(dns)
            return
        time.sleep(0.2)
    raise RuntimeError('Owned adapter remained after shutdown: ' + adapter)


def wait_parked(adapter):
    # A stopped tunnel keeps its adapter for the helper's next connect: media-down,
    # with no routes, addresses or DNS beyond what Windows gives every interface.
    script = ("$a = @(Get-NetAdapter -IncludeHidden -ErrorAction Stop | Where-Object Name -eq '" + adapter + "'); "
        "$i = if ($a.Count -eq 1) { $a[0].ifIndex } else { -1 }; "
        "@{ count = $a.Count; up = @($a | Where-Object Status -eq 'Up').Count; index = $i; "
        "routes = @(Get-NetRoute -InterfaceIndex $i -ErrorAction SilentlyContinue | Where-Object DestinationPrefix -notmatch "
        "'^(ff[0-9a-f]{2}:|fe80:|224\\.0\\.0\\.0/4|255\\.255\\.255\\.255/32|169\\.254\\.)' | ForEach-Object DestinationPrefix); "
        "addresses = @(Get-NetIPAddress -InterfaceIndex $i -ErrorAction SilentlyContinue | Where-Object IPAddress -notmatch '^(fe80:|169\\.254\\.)' | ForEach-Object IPAddress); "
        "dns = @(Get-DnsClientServerAddress -InterfaceIndex $i -ErrorAction SilentlyContinue | ForEach-Object ServerAddresses | Where-Object { $_ -notmatch '^fec0:0:0:ffff::[123]$' }) "
        "} | ConvertTo-Json -Compress")
    for _ in range(30):
        state = json.loads(powershell(script))
        if state['count'] == 1 and not state['up'] and not state['routes'] and not state['addresses'] and not state['dns']:
            dns_probe(True)
            return state['index']
        time.sleep(0.2)
    raise RuntimeError('Stopped adapter was not parked clean: ' + json.dumps(state))


def kill_pid(pid):
    kernel = ctypes.windll.kernel32
    kernel.OpenProcess.restype = ctypes.c_void_p
    handle = kernel.OpenProcess(1, False, pid)
    assert handle, 'Could not open the test-owned helper'
    try:
        assert kernel.TerminateProcess(ctypes.c_void_p(handle), 1), 'Could not terminate the test-owned helper'
    finally:
        kernel.CloseHandle(ctypes.c_void_p(handle))


if deny_elevation:
    assert not ctypes.windll.shell32.IsUserAnAdmin(), 'Run the denial check without elevation.'
    broker = start_process([str(core)])
    print('Choose No in the Windows permission prompt.', flush=True)
    try:
        try:
            request(broker, 'runVPN', {'configJSON': json.dumps({
                'inbounds': [{'protocol': 'tun'}, {'protocol': 'socks', 'listen': '127.0.0.1', 'port': free_port()}],
                'outbounds': [{'protocol': 'blackhole'}],
            })})
        except RuntimeError as error:
            assert str(error) == 'Native startup failed: elevation_denied', str(error)
        else:
            raise AssertionError('Permission was accepted; denial was not tested.')
    finally:
        broker.stdin.close()
        broker.wait(timeout=15)
    print('Windows UAC denial returned elevation_denied and the broker exited.', flush=True)
    raise SystemExit(0)

http_server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
threading.Thread(target=http_server.serve_forever, daemon=True).start()
dns = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
dns.bind(('127.0.0.1', 0))
dns_port = dns.getsockname()[1]
threading.Thread(target=dns_server, args=(dns,), daemon=True).start()
guard_probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
guard_probe.bind(('127.0.0.1', 53))
threading.Thread(target=dns_server, args=(guard_probe,), daemon=True).start()
upstream_port, socks_port = free_port(), free_port()
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as route_probe:
    # UDP connect chooses a source address without sending a packet.
    route_probe.connect(('192.0.2.1', 9))
    physical_address = route_probe.getsockname()[0]
assert not ipaddress.ip_address(physical_address).is_loopback
physical_index = int(powershell("Get-NetIPAddress -AddressFamily IPv4 -IPAddress '" + physical_address + "' | Select-Object -First 1 -ExpandProperty InterfaceIndex"))
def physical_connection():
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        client.settimeout(2)
        # Windows IP_UNICAST_IF takes an interface index in network byte order.
        client.setsockopt(socket.IPPROTO_IP, 31, struct.pack('!I', physical_index))
        client.connect((physical_address, upstream_port))
        return client
    except BaseException:
        client.close()
        raise

def freedom(tag, port):
    return {'tag': tag, 'protocol': 'freedom', 'settings': {'redirect': '127.0.0.1:' + str(port), 'finalRules': [{'action': 'allow', 'ip': ['127.0.0.1/32']}]}}

fixtures = ExitStack()
try:
    server = start_process([str(core)])
    request(server, 'runXrayFromJson', {'configJSON': json.dumps({
        'log': {'loglevel': 'none'},
        'inbounds': [{'listen': physical_address, 'port': upstream_port, 'protocol': 'vless', 'settings': {'decryption': 'none', 'clients': [{'id': user_id}]}}],
        'outbounds': [{'tag': 'block', 'protocol': 'blackhole'}, freedom('http-fixture', http_server.server_port), freedom('dns-fixture', dns_port)],
        'routing': {'rules': [
            {'type': 'field', 'ip': ['198.18.0.53/32'], 'network': 'udp', 'port': str(dns_port), 'outboundTag': 'dns-fixture'},
            {'type': 'field', 'ip': ['198.18.0.1/32', '2001:db8::1/128'], 'network': 'tcp', 'port': str(http_server.server_port), 'outboundTag': 'http-fixture'},
        ]},
    })})
    config = {
        'inbounds': [{'protocol': 'tun', 'port': 0, 'settings': {'name': 'ignored'}}, {'listen': '127.0.0.1', 'protocol': 'socks', 'port': socks_port}],
        'outbounds': [{'tag': 'proxy', 'protocol': 'vless', 'settings': {'vnext': [{'address': physical_address, 'port': upstream_port, 'users': [{'id': user_id, 'encryption': 'none'}]}]}}],
        'dns': {'servers': [{'address': '198.18.0.53', 'port': dns_port}]},
    }
    if arguments.protocol.startswith('tuic-'):
        port, certificate = fixtures.enter_context(android_tuic_peer(root, http_server.server_port, dns_port,
            listen_host=physical_address, listen_port=upstream_port))
        config['outbounds'][0] = {'tag': 'proxy', 'protocol': 'tuic', 'settings': {
            'address': physical_address, 'port': port, 'uuid': user_id, 'password': 'synthetic-tuic-only',
            'udpRelayMode': arguments.protocol.removeprefix('tuic-')}, 'streamSettings': {'security': 'tls',
            'tlsSettings': {'serverName': 'tuic-fixture.example', 'alpn': ['h3'], 'disableSystemRoot': True,
                'certificates': [{'usage': 'verify', 'certificate': base64.b64decode(certificate).decode().splitlines()}]}}}
    print('Tunnel protocol: ' + arguments.protocol, flush=True)
    dns_probe(True)
    http_target('198.18.0.1', http_server.server_port, False)
    for mode in arguments.case or modes:
        if mode == 'per-app':
            # The Dart suite drives the app's controller against the release bundle with its own peers.
            flutter = root / '.toolchains/flutter/bin/flutter.bat'
            flutter = str(flutter) if flutter.is_file() else shutil.which('flutter')
            if not flutter:
                raise SystemExit('Flutter is required for the per-app case.')
            subprocess.run([flutter, 'test', 'test/windows_vpn_features.dart'], cwd=root, check=True)
            wait_clean(session_adapter)
            print('per-app: per-app TCP/UDP routing, repair and cleanup passed', flush=True)
            continue
        args = [sys.executable, str(Path(__file__).resolve()), '--owner', str(core)] if mode == 'app-owner-death' else [str(core)]
        broker = start_process(args)
        if mode == 'startup-cancel':
            broker.stdin.write(json.dumps({'apiVersion': 1, 'method': 'runVPN', 'payload': {'configJSON': json.dumps(config), 'reuseSession': True}}) + '\n')
            broker.stdin.flush()
            broker.stdin.close()
            broker.wait(timeout=15)
            time.sleep(2)
            assert powershell("@(Get-NetAdapter -IncludeHidden | Where-Object Name -like 'elarni-*').Count") == '0', 'Cancelled startup left an adapter'
            dns_probe(True)
            print('startup-cancel: owner EOF prevented tunnel retention', flush=True)
            continue
        options = {'memoryLimitMB': 45}
        if mode == 'reconnect':
            options['reuseSession'] = True
        current = json.loads(json.dumps(config))
        if mode == 'route-enforcement':
            options['routePolicy'] = {'includedRoutes': ['198.18.0.0/16', '2001:db8::/32', physical_address + '/32'],
                'excludedRoutes': ['198.18.0.99/32'], 'includeAllNetworks': False, 'enforceRoutes': True, 'hideVPNIcon': False}
            with physical_connection():
                pass
        if mode == 'block-broker-death':
            options['routePolicy'] = {'includedRoutes': ['0.0.0.0/0', '::/0'], 'excludedRoutes': [], 'includeAllNetworks': False,
                'enforceRoutes': False, 'hideVPNIcon': False, 'blockWithoutVPN': True}
        if mode == 'session-limits':
            options.update(tcpMaxConnections=1, udpMaxConnections=1, streamMetrics=True)
            options['routePolicy'] = {'includedRoutes': ['198.18.0.0/16', '2001:db8::/32'],
                'excludedRoutes': [], 'includeAllNetworks': False, 'enforceRoutes': False, 'hideVPNIcon': False}
            current['stats'] = {}
            current['policy'] = {'levels': {'0': {'connIdle': 1}},
                'system': {'statsInboundUplink': True, 'statsInboundDownlink': True}}
        ready = request(broker, 'runVPN', {'configJSON': json.dumps(current), **options})
        metrics = {}
        if mode == 'session-limits':
            def read_metrics():
                for line in broker.stdout:
                    value = json.loads(line)
                    if value.get('event') == 'metrics':
                        metrics.update(value['data'])
                        metrics['receivedAt'] = time.monotonic()
            threading.Thread(target=read_metrics, daemon=True).start()
        def wait_sessions(kind, count=0):
            started = time.monotonic()
            deadline = started + 12
            key = 'active' + kind + 'Sessions'
            quiet = None
            samples = []
            last_sample = None
            while time.monotonic() < deadline:
                if metrics.get('receivedAt') != last_sample:
                    last_sample = metrics.get('receivedAt')
                    samples.append((round(time.monotonic() - started, 2), metrics.get(key)))
                if metrics.get('receivedAt', 0) > started and metrics.get(key) == count:
                    quiet = quiet or time.monotonic()
                    if time.monotonic() - quiet >= 2:
                        return
                else:
                    quiet = None
                time.sleep(0.1)
            raise AssertionError(key + ' did not reach ' + str(count) + ': ' + str(metrics) +
                '; samples=' + str(samples) + '; brokerExit=' + str(broker.poll()) +
                '; metricAge=' + str(round(time.monotonic() - metrics.get('receivedAt', started), 2)))
        adapter = ready['adapter']
        # Fixed per Windows session, so NLA keeps one network profile instead of one per connect.
        assert adapter == session_adapter, 'Unexpected owned adapter identity: ' + adapter
        adapters.append(adapter)
        if mode == 'session-limits':
            # This one-slot fixture admits only its controlled flows. Windows
            # background DNS otherwise competes for the same UDP slot. DNS
            # ownership is exercised by graceful/reconnect; this adapter is
            # disposable and the WFP guard stays active throughout this case.
            remaining = powershell("Set-DnsClientServerAddress -InterfaceAlias '" + adapter +
                "' -ServerAddresses @('127.0.0.1','::1') -ErrorAction Stop; @(Get-DnsClientServerAddress -InterfaceAlias '" +
                adapter + "' | ForEach-Object {$_.ServerAddresses}) | ConvertTo-Json -Compress")
            assert '127.0.0.1' in remaining and '198.51.100.253' not in remaining and 'fd76:6f75:7465::1' not in remaining, 'Admission fixture still owns OS DNS queries: ' + remaining
        routes = json.loads(powershell("@(Get-NetRoute -InterfaceAlias '" + adapter + "' | Select-Object -ExpandProperty DestinationPrefix) | ConvertTo-Json -Compress"))
        if mode == 'route-enforcement':
            prefixes = [ipaddress.ip_network(value) for value in routes]
            assert any(ipaddress.ip_address('198.18.0.1') in p for p in prefixes)
            assert not any(ipaddress.ip_address('198.18.0.99') in p for p in prefixes), 'Excluded route was captured'
            try:
                with physical_connection():
                    raise AssertionError('Physical bypass of enforced route was allowed')
            except OSError:
                pass
        elif mode == 'session-limits':
            assert {'198.18.0.0/16', '2001:db8::/32'}.issubset(set(routes))
        else:
            prefixes = [ipaddress.ip_network(value) for value in routes]
            def captured(address):
                return any(ipaddress.ip_address(address) in p for p in prefixes)
            for address in ('8.8.8.8', '198.18.0.1', '203.0.113.9', '255.255.255.254', '2001:db8::1', '2a00::1'):
                assert captured(address), 'Missing capture route for ' + address + ': ' + str(routes)
            # LAN discovery stays on the physical network unless Block traffic without VPN keeps
            # everything in the tunnel; Windows then picks another interface's discovery routes.
            blocked = mode == 'block-broker-death'
            # The adapter keeps Windows' own routes to these, demoted below every other interface's.
            own = {'224.0.0.0/4', '255.255.255.255/32', 'ff00::/8'}
            # Find-NetRoute cannot resolve multicast destinations, so pick the route the way Windows
            # does: the longest matching prefix, then the lowest route plus interface metric.
            table = json.loads(powershell('@(Get-NetRoute -ErrorAction SilentlyContinue | Select-Object '
                'DestinationPrefix,InterfaceAlias,RouteMetric,InterfaceMetric) | ConvertTo-Json -Compress'))
            for address in ('224.0.0.251', '239.255.255.250', '255.255.255.255', 'ff02::fb'):
                assert blocked == any(ipaddress.ip_address(address) in p for p in prefixes if str(p) not in own), \
                    'Capture route for ' + address + ' in ' + str(routes)
                # A route without an interface metric has no IP interface for its family: unusable.
                matches = [(ipaddress.ip_network(row['DestinationPrefix']).prefixlen,
                            -(row['RouteMetric'] + row['InterfaceMetric']), row['InterfaceAlias']) for row in table
                           if row['RouteMetric'] is not None and row['InterfaceMetric'] is not None
                           and ipaddress.ip_address(address) in ipaddress.ip_network(row['DestinationPrefix'])]
                assert matches, 'No route to ' + address
                best = max(matches)[:2]
                interfaces = sorted({alias for length, metric, alias in matches if (length, metric) == best})
                assert (adapter in interfaces) == blocked, 'Discovery to ' + address + ' picks ' + str(interfaces) + ' from ' + \
                    str([row for row in table if ipaddress.ip_address(address) in ipaddress.ip_network(row['DestinationPrefix'])]) + \
                    ' ' + powershell('Get-NetIPInterface -InterfaceAlias \'' + adapter + '\' -ErrorAction SilentlyContinue | '
                        'Select-Object AddressFamily,InterfaceMetric,ConnectionState | ConvertTo-Json -Compress')
        http_target('2001:db8::1' if mode == 'session-limits' else '198.18.0.1', http_server.server_port)
        if mode == 'session-limits':
            wait_sessions('Tcp')
        http_target('198.18.0.1' if mode == 'session-limits' else '2001:db8::1', http_server.server_port)
        if mode == 'session-limits':
            wait_sessions('Tcp')
            with socket.create_connection(('198.18.0.1', http_server.server_port), timeout=2) as held:
                held.sendall(b'GET / HTTP/1.1\r\n')
                time.sleep(0.1)
                http_target('198.18.0.1', http_server.server_port, False)
            wait_sessions('Tcp')
            http_target('198.18.0.1', http_server.server_port)
            wait_sessions('Udp')
            labels = b''.join(bytes([len(label)]) + label.encode('ascii') for label in fixture_name.split('.')) + b'\0'
            packet = struct.pack('!HHHHHH', 5432, 0x0100, 1, 0, 0, 0) + labels + struct.pack('!HH', 1, 1)
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as first, socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as second:
                first.settimeout(2); second.settimeout(0.3)
                first.sendto(packet, ('198.18.0.53', dns_port))
                assert first.recv(65536)[:2] == packet[:2], 'First UDP session failed'
                second.sendto(packet, ('198.18.0.53', dns_port))
                try:
                    second.recv(65536)
                    raise AssertionError('UDP session limit was exceeded')
                except socket.timeout:
                    pass
                wait_sessions('Udp')
                second.settimeout(2)
                second.sendto(packet, ('198.18.0.53', dns_port))
                assert second.recv(65536)[:2] == packet[:2], 'Expired UDP capacity was not reusable'
            broker.stdin.close()
        elif mode in ('graceful', 'reconnect'):
            resolved = powershell("@(Resolve-DnsName '" + fixture_name + "' -Type A -DnsOnly -ErrorAction Stop | Where-Object IPAddress | Select-Object -ExpandProperty IPAddress) | ConvertTo-Json -Compress")
            assert '198.18.0.1' in resolved and 1 in dns_queries, 'Windows DNS did not traverse the tunnel'
            dns_probe(False)
            if mode == 'reconnect':
                # Out-of-tunnel probes must retain the active adapter and owner.
                if arguments.protocol == 'vless':
                    probe = start_process([str(core)])
                    measured = request(probe, 'pingEndpoint', {'address': physical_address, 'port': upstream_port, 'timeout': 5})
                    assert measured['delay'] >= 0
                    probe.stdin.close(); probe.wait(timeout=10)
                http_target('198.18.0.1', http_server.server_port)
                dns_probe(False)
                for memory in (128, 0):
                    request(broker, 'stopVPN', {})
                    parked = wait_parked(adapter)
                    options['memoryLimitMB'] = memory
                    restarted = request(broker, 'runVPN', {'configJSON': json.dumps(current), **options})
                    assert restarted['helperPid'] == ready['helperPid'], 'Reconnect replaced the elevated owner'
                    # The identity is fixed per Windows session, so NLA keeps one profile.
                    assert restarted['adapter'] == adapter, 'Reconnect changed the adapter identity'
                    http_target('198.18.0.1', http_server.server_port)
                    assert powershell("(Get-NetAdapter -IncludeHidden -Name '" + adapter + "').ifIndex") == str(parked), 'Reconnect replaced the parked adapter'
                    http_target('2001:db8::1', http_server.server_port)
                    for kind, address in (('A', '198.18.0.1'), ('AAAA', '2001:db8::1')):
                        result = powershell("@(Resolve-DnsName '" + fixture_name + "' -Server 198.51.100.253 -Type " + kind + " -DnsOnly -ErrorAction Stop | Where-Object IPAddress | Select-Object -ExpandProperty IPAddress) | ConvertTo-Json -Compress")
                        assert address in result, 'DNS failed after reconnect'
                    dns_probe(False)
            broker.stdin.close()
        elif mode == 'route-enforcement':
            broker.stdin.close()
        elif mode == 'adapter-loss':
            # Nothing reaches the tunnel once its adapter is down, so the session must end and release DNS.
            powershell("Disable-NetAdapter -Name '" + adapter + "' -Confirm:$false -ErrorAction Stop")
            try:
                broker.wait(timeout=10)
            except subprocess.TimeoutExpired:
                # Later cases must not inherit a disabled adapter.
                powershell("Enable-NetAdapter -Name '" + adapter + "' -Confirm:$false -ErrorAction Stop")
                raise AssertionError('The session stayed connected after its adapter was disabled')
            wait_clean(adapter)
            # Recovery reconnects right away, and that connect must get a working adapter.
            broker = start_process([str(core)])
            ready = request(broker, 'runVPN', {'configJSON': json.dumps(current), **options})
            assert ready['adapter'] == adapter, 'Unexpected owned adapter identity: ' + ready['adapter']
            http_target('198.18.0.1', http_server.server_port)
            broker.stdin.close()
        elif mode == 'helper-death':
            # A live guard survives the app's unelevated check and an elevated clear.
            assert native('staleVPNGuard', {}) == {'stale': False}, 'A live DNS guard was reported stale'
            assert subprocess.run([str(core), '--clear-guard'], stdin=subprocess.DEVNULL, timeout=30).returncode == 0, 'Clearing beside a live DNS guard failed'
            dns_probe(False)
            http_target('198.18.0.1', http_server.server_port)
            kill_pid(ready['helperPid'])
        else:
            broker.kill()
        broker.wait(timeout=15)
        if mode == 'helper-death':
            # Fail closed: the crashed helper's guard keeps blocking DNS...
            wait_clean(adapter, dns=False)
            assert native('staleVPNGuard', {}) == {'stale': True}, 'The crashed DNS guard was not detected'
            # ...until the next connect clears it, before it resolves any name.
            native('clearVPNGuard', {})
            dns_probe(True)
            assert native('staleVPNGuard', {}) == {'stale': False}, 'The cleared DNS guard was still reported'
            broker = start_process([str(core)])
            ready = request(broker, 'runVPN', {'configJSON': json.dumps(current), **options})
            assert ready['adapter'] == adapter, 'Unexpected owned adapter identity: ' + ready['adapter']
            resolved = powershell("@(Resolve-DnsName '" + fixture_name + "' -Type A -DnsOnly -ErrorAction Stop | Where-Object IPAddress | Select-Object -ExpandProperty IPAddress) | ConvertTo-Json -Compress")
            assert '198.18.0.1' in resolved, 'Windows DNS failed on the connect after a helper crash'
            dns_probe(False)
            http_target('198.18.0.1', http_server.server_port)
            broker.stdin.close()
            broker.wait(timeout=15)
        if mode == 'block-broker-death':
            # Block traffic without VPN fails closed: the helper's guard outlives its broker...
            wait_clean(adapter, dns=False)
            try:
                with physical_connection():
                    raise AssertionError('Traffic left outside the dead tunnel')
            except OSError:
                pass
            assert native('staleVPNGuard', {}) == {'stale': True}, 'The kept block was not reported'
            # ...until the next connect or Repair VPN setup clears it.
            native('clearVPNGuard', {})
            with physical_connection():
                pass
        wait_clean(adapter)
        if mode == 'route-enforcement':
            with physical_connection():
                pass
        print(mode + ': IPv4/IPv6 traffic and resource cleanup passed', flush=True)
    print('Windows VPN acceptance passed: ' + ', '.join(arguments.case or modes), flush=True)
finally:
    fixtures.close()
    for process in reversed(processes):
        if process.poll() is None:
            try:
                process.stdin.close()
                process.wait(timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                process.kill()
                process.wait(timeout=5)
    for adapter in adapters:
        wait_clean(adapter)
    dns.close()
    guard_probe.close()
    http_server.shutdown()
    http_server.server_close()
